{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --minify",
        "watch:css": "tailwindcss -i resources/css/app.css -o public/css/app.css --watch",
        "test:dom": "node tests/dom/run.mjs",
        "test:dom:full": "node tests/dom/run.mjs --full"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.0.0",
        "jsdom": "^25.0.1",
        "pyodide": "^0.26.4",
        "tailwindcss": "^4.0.0"
    }
}

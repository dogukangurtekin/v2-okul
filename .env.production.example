# v2-okul ÜRETİM ayarları. Sunucuda `.env` olarak kopyalayın; bu dosyadaki ??? alanlarını doldurun.
# `.env` hiçbir zaman GitHub'a gönderilmez (.gitignore).

APP_NAME="Bilişim Kod Okul"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --force ile üretin
APP_DEBUG=false               # ÜRETİMDE ASLA true olmasın: hata sayfaları kod/şifre sızdırır
APP_URL=https://???.bilisimkod.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=daily
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# hPanel > Veritabanları > MySQL ile oluşturduğunuz değerler
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=???
DB_USERNAME=???
DB_PASSWORD=???

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # yalnızca https üzerinden çerez
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# İlk yönetici (yalnızca `php artisan db:seed` ilk kez çalışırken). Boş bırakırsanız rastgele şifre üretilip bir kez yazdırılır.
ADMIN_EMAIL=???
ADMIN_PASSWORD=

# Veli bildirimi: log (yalnızca kayıt) | whatsapp
PARENT_CHANNEL=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=

# Web Push (composer require minishlink/web-push + php artisan push:vapid)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:???

GRADE_XP=false
ATTENDANCE_REMINDER_AT=10:00
# İnternetsiz okul için Pyodide'i kendi sunucunuzdan servis edin:
# PYODIDE_URL=/vendor/pyodide/
